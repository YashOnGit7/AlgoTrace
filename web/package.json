{
  "name": "@algotrace/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "pnpm --dir .. build:wasm && vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --passWithNoTests --exclude **/*.integration.test.mjs --exclude e2e/**",
    "test:wasm": "vitest run src/engine/realWasm.integration.test.mjs src/engine/compilerWasm.integration.test.mjs",
    "test:e2e": "pnpm --dir .. build:wasm && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@algotrace/compiler": "workspace:*",
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^12.4.4",
    "lightweight-charts": "^5.0.3",
    "plotly.js": "^2.35.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/plotly.js": "^2.35.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
